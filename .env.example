# ==============================================================================
# CivicSense AI — Environment Configuration
# ==============================================================================
# Firebase Authentication & Cloud Firestore configuration is loaded from:
#   firebase-applet-config.json (apiKey, authDomain, projectId, firestoreDatabaseId)
# No separate database connection string or auth signing secret is required.

# ------------------------------------------------------------------------------
# 1. Core Server Runtime (Required in production; defaults provided for local)
# ------------------------------------------------------------------------------
# PORT: HTTP port for the Express + Vite server (default: 3000)
PORT="3000"

# NODE_ENV: Runtime mode ("development" or "production")
NODE_ENV="development"

# APP_URL: Public base URL of the deployed application (injected in Cloud Run / AI Studio)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Optional AI/ML Service (Not required — safe fallback active when unset)
# ------------------------------------------------------------------------------
# ML_SERVICE_URL: Base URL of the standalone Python FastAPI ML service (e.g. http://localhost:8000).
# When unset or unreachable, CivicSense AI clearly labels and uses the baseline rule classifier.
ML_SERVICE_URL=""

# ------------------------------------------------------------------------------
# 3. Optional External Notification Providers (Not required to function)
# ------------------------------------------------------------------------------
# In-app notifications are persisted in Cloud Firestore (/notifications) without SMTP or SMS.
# Configure these only if adding external email/SMS delivery hooks:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMS_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# 4. Unnecessary Variables with Firebase Auth & Cloud Firestore (Do NOT set)
# ------------------------------------------------------------------------------
# - JWT_SECRET / AUTH_SECRET / SESSION_SECRET: Unnecessary; Firebase Auth signs/verifies ID tokens.
# - DEMO_MODE: Unnecessary; local demo/in-memory accounts are removed.
# - DATABASE_URL: Unnecessary; Cloud Firestore is configured via firebase-applet-config.json.
# - GEMINI_API_KEY: Unnecessary for CivicSense AI unless adding optional Gemini features later.
